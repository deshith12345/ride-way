MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/DATABASE"
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth
# Add this redirect URI in Google Cloud:
# https://your-vercel-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Password reset email via Gmail SMTP
GMAIL_USER="supportrideway@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-gmail-app-password"
PASSWORD_RESET_FROM_EMAIL="RideWay <supportrideway@gmail.com>"

# Optional image uploads for admin bus photos
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
